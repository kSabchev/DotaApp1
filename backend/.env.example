# Copy to .env for local overrides, or set in your hosting dashboard.

# Port to listen on. Most hosts (e.g. Render) set this automatically — leave unset there.
PORT=3001

# Comma-separated list of allowed frontend origins (CORS). Defaults to the local
# Vite dev server if unset. In production, set this to your deployed frontend URL:
CORS_ORIGIN=https://your-app.vercel.app
